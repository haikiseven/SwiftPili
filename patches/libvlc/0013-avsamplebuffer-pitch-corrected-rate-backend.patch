+#pragma mark helpers
+
+- (BOOL)isClosedLockedOrSnapshotGen:(uint64_t *)outGen
+{
+    os_unfair_lock_lock(&_stateLock);
+    BOOL closed = _closed || _aout == NULL;
+    if (outGen != NULL)
+        *outGen = _sessionGen;
+    os_unfair_lock_unlock(&_stateLock);
+    return closed;
+}
+
+- (void)dispatchCallbackWithGen:(uint64_t)gen
+                          block:(void (^)(audio_output_t *aout))block
+{
+    __weak typeof(self) weakSelf = self;
+    dispatch_async(_callbackQueue, ^{
+        VLCAudioEngine *s = weakSelf;
+        if (s == nil) return;
+        os_unfair_lock_lock(&s->_stateLock);
+        audio_output_t *aout = (!s->_closed && s->_aout != NULL && gen == s->_sessionGen)
+            ? s->_aout : NULL;
+        os_unfair_lock_unlock(&s->_stateLock);
+        if (aout != NULL)
+            block(aout);
+    });
+}
+
+/* FEED-DIAG: last successful enqueue age in ms (0 if never enqueued). */
+- (int64_t)lastEnqueueAgoMsLocked
+{
+    if (_lastEnqueueTick == 0)
+        return -1;
+    vlc_tick_t ago = vlc_tick_now() - _lastEnqueueTick;
+    if (ago < 0)
+        ago = 0;
+    return (int64_t)(ago / 1000); /* vlc_tick is us */
+}
+
+- (BOOL)isFeedUnderrunLocked
+{
+    int64_t unplayedW = [self unplayedWallFramesLocked];
+    return (unplayedW == 0 && _pendingWall == 0 && _rawChain == NULL
+            && _started && !_paused && !_interrupted);
+}
+
+/* Event-driven underrun enter/leave. Call after enqueue/feed/timing. */
+- (void)observeFeedUnderrunLocked
+{
+    BOOL now = [self isFeedUnderrunLocked];
+    if (now && !_feedUnderrunActive) {
+        _feedUnderrunActive = YES;
+        _feedBurstUntil = vlc_tick_now() + 3000000; /* dense 3s after edge */
+        msg_Warn(_aout,
+                 "[avae-feed] UNDERRUN_EDGE lastEnqAgoMs=%lld enqF=%lld enqN=%lld "
+                 "consC=%lld contentIn=%lld dropped=%lld dropN=%lld rawF=%lld "
+                 "pendingW=%d unplayedW=%lld playRate=%.2f epoch=%llu FEED-DIAG",
+                 (long long)[self lastEnqueueAgoMsLocked],
+                 (long long)_enqueuedFrames, (long long)_enqueuedCalls,
+                 (long long)_contentConsumed, (long long)_contentIn,
+                 (long long)_droppedFrames, (long long)_dropEvents,
+                 (long long)_rawQueuedFrames, (int)_pendingWall,
+                 (long long)[self unplayedWallFramesLocked],
+                 _playbackRate, (unsigned long long)_epoch);
+    } else if (!now && _feedUnderrunActive) {
+        _feedUnderrunActive = NO;
+        /* K2.4: next non-underrun reportTiming must re-anchor diag deltas
+         * before aout_TimingReport so core does not see a mega ratio. */
+        _timingResume = YES;
+        _feedBurstUntil = vlc_tick_now() + 3000000;
+        msg_Warn(_aout,
+                 "[avae-feed] REFILL_EDGE lastEnqAgoMs=%lld enqF=%lld enqN=%lld "
+                 "consC=%lld contentIn=%lld dropped=%lld dropN=%lld rawF=%lld "
+                 "pendingW=%d unplayedW=%lld playRate=%.2f epoch=%llu FEED-DIAG",
