+/* Report drained once every enqueued sample has been played. Called from the
+ * time observer (playback progress) and from drain() itself (already done /
+ * never started). Not under _bufferLock when locked==NO; takes the lock. */
+- (void)checkDrainedLocked:(BOOL)alreadyLocked
+{
+    if (!alreadyLocked)
+        vlc_mutex_lock(&_bufferLock);
+
+    if (!_draining)
+    {
+        if (!alreadyLocked)
+            vlc_mutex_unlock(&_bufferLock);
+        return;
+    }
+
+    /* Still moving module-side blocks into the renderer. */
+    if (_outChain != NULL)
+    {
+        if (!alreadyLocked)
+            vlc_mutex_unlock(&_bufferLock);
+        return;
+    }
+
+    /* Nothing was ever started — nothing to play out. */
+    if (_ptsSamples < 0 || !_dateReached || _stopped)
+    {
+        _draining = NO;
+        if (!alreadyLocked)
+            vlc_mutex_unlock(&_bufferLock);
+        aout_DrainedReport(_aout);
+        return;
+    }
+
+    const int64_t endSamples = _ptsSamples;
+    const unsigned sampleRate = _sampleRate;
+    AVSampleBufferRenderSynchronizer *sync = _sync;
+    if (!alreadyLocked)
+        vlc_mutex_unlock(&_bufferLock);
+
+    if (sync == nil)
+    {
+        vlc_mutex_lock(&_bufferLock);
+        _draining = NO;
+        vlc_mutex_unlock(&_bufferLock);
+        aout_DrainedReport(_aout);
+        return;
+    }
+
+    CMTime cur = sync.currentTime;
+    CMTime end = CMTimeMake(endSamples, sampleRate);
+    /* currentTime can briefly exceed end once the last buffer has rendered. */
+    if (CMTimeCompare(cur, end) < 0)
+        return;
+
+    vlc_mutex_lock(&_bufferLock);
+    if (!_draining)
+    {
+        vlc_mutex_unlock(&_bufferLock);
+        return;
+    }
+    _draining = NO;
+    vlc_mutex_unlock(&_bufferLock);
+    msg_Dbg(_aout, "avsamplebuffer: drain complete (played %"PRId64" samples)",
+            endSamples);
+    aout_DrainedReport(_aout);
+}
+
+- (void)drain
+{
+    /* libVLC aout->drain: wait until the deep AVSampleBuffer queue has
+     * actually rendered the tail, then aout_DrainedReport. Without this the
+     * core uses stream_GetDelay()+now as a deadline and stops the input
+     * early — F20 silent last seconds (docs/PLAYER_DESIGN.md,
+     * docs/AUDIO_RATE_REWORK.md §9). */
+    vlc_mutex_lock(&_bufferLock);
+    if (_ptsSamples < 0 || _stopped)
+    {
+        vlc_mutex_unlock(&_bufferLock);
+        aout_DrainedReport(_aout);
+        return;
+    }
+    _draining = YES;
+    vlc_mutex_unlock(&_bufferLock);
+
+    /* May already be past the end (tiny tail / already idle). */
+    [self checkDrainedLocked:NO];
 }
 
