             in->b_eof = true;
         }
     }
 }
 
-static void SlaveSeek( input_thread_t *p_input )
+/**
+ * Seek every slave to the point the master was ASKED to seek to.
+ *
+ * @param pi_requested_time the time the master was asked for, or NULL when the
+ *        caller has no such time (a seekpoint, or a position-only seek). NULL
+ *        falls back to DEMUX_GET_TIME, i.e. to wherever the master landed.
+ *
+ * DEMUX_GET_TIME reports where the master *landed*, which for a fragmented
+ * stream is the start of the fragment containing the request, not the request
+ * itself. Handing that to the slaves is wrong twice over:
+ *
+ *  - The slave then lands on the fragment containing the MASTER's fragment
+ *    start. When the two streams use different fragment durations (DASH audio
+ *    is AAC-frame aligned, so its fragments run a few ms longer than video's),
+ *    that is a whole fragment earlier than the master -- seconds of audio played
+ *    before the first video frame is due.
+ *
+ *  - Worse, an accurate DEMUX_SET_TIME makes the demuxer publish its target as
+ *    the es_out preroll point (ES_OUT_SET_NEXT_DISPLAY_TIME). That point is
+ *    global, and the slaves run after the master, so the slave OVERWRITES the
+ *    master's preroll with the master's own landing time. i_preroll_duration
+ *    then computes as zero and nothing is prerolled: playback resumes at the
+ *    fragment boundary and crawls to the requested time at 1x, instead of
+ *    discarding the run-up at full speed during the buffering phase.
+ *
+ * Seeking the slaves to the requested time fixes both: they land no earlier than
+ * the master, and every demuxer publishes the same preroll point.
+ *
+ * Falling back to the landing time when the request is unreachable keeps the
+ * near-EOF behaviour: a slave shorter than the master must not be marked b_eof
+ * (which disables it for good) merely because the request lies past its end.
+ */
+static void SlaveSeek( input_thread_t *p_input, const vlc_tick_t *pi_requested_time )
 {
-    vlc_tick_t i_time;
+    vlc_tick_t i_landed_time;
+    bool b_have_landed_time =
+        demux_Control( input_priv(p_input)->master->p_demux, DEMUX_GET_TIME,
+                       &i_landed_time ) == VLC_SUCCESS;
 
-    if( demux_Control( input_priv(p_input)->master->p_demux, DEMUX_GET_TIME, &i_time ) )
+    if( pi_requested_time == NULL && !b_have_landed_time )
     {
         msg_Err( p_input, "demux doesn't like DEMUX_GET_TIME" );
         return;
     }
 
     for (size_t i = 0; i < input_priv(p_input)->i_slave; i++)
     {
         input_source_t *in = input_priv(p_input)->slave[i];
+        int i_ret = VLC_EGENERIC;
+
+        if( pi_requested_time != NULL )
+            i_ret = demux_Control( in->p_demux, DEMUX_SET_TIME,
+                                   *pi_requested_time, true );
+
+        /* The request may lie past this slave's end, or simply not be seekable
+         * there. Do not lose the slave over it: fall back to wherever the master
+         * landed, which is where we used to seek unconditionally. */
+        if( i_ret != VLC_SUCCESS && b_have_landed_time
+         && ( pi_requested_time == NULL || *pi_requested_time != i_landed_time ) )
+            i_ret = demux_Control( in->p_demux, DEMUX_SET_TIME, i_landed_time, true );
 
-        if( demux_Control( in->p_demux, DEMUX_SET_TIME, i_time, true ) )
+        if( i_ret != VLC_SUCCESS )
         {
             if( !in->b_eof )
                 msg_Err(p_input, "seek failed for slave %zu -> EOF", i);
             in->b_eof = true;
         }
         else
         {
             in->b_eof = false;
         }
     }
 }
 
