 #define SLAVE_ADD_FORCED    (1<<0)
@@ -1923,25 +1923,30 @@ static int ControlSetTime( input_thread_t *p_input, vlc_tick_t val,
         /* Emulate it with a SET_POS */
         if( i_length > 0 )
         {
             double f_pos = (double)(priv->i_start + val) / (double)i_length;
             i_ret = demux_SetPosition( priv->master->p_demux, f_pos,
                                        !fast_seek );
         }
     }
 
     if( i_ret == VLC_SUCCESS )
     {
         if( priv->i_slave > 0 )
-            SlaveSeek( p_input );
+        {
+            /* Seek the slaves to what was REQUESTED, not to where the master
